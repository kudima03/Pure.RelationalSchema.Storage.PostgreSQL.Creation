<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageValidationBaselineVersion>0.1.0-preview.1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>Pure.RelationalSchema.Storage.PostgreSQL.Creation</PackageId>
    <RootNamespace>Pure.RelationalSchema.Storage.PostgreSQL.Creation</RootNamespace>
    <AssemblyName>Pure.RelationalSchema.Storage.PostgreSQL.Creation</AssemblyName>
    <Authors>Dmitry Kurochkin</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/kudima03/Pure.RelationalSchema.Storage.PostgreSQL.Creation</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Pure.Primitives" Version="3.8.0" />
    <PackageReference Include="Pure.Primitives.Abstractions" Version="4.4.0" />
    <PackageReference Include="Pure.Primitives.Choices" Version="1.4.0" />
    <PackageReference Include="Pure.Primitives.String.Operations" Version="1.8.0" />
    <PackageReference Include="Pure.Primitives.Switches" Version="2.0.0" />
    <PackageReference Include="Pure.RelationalSchema" Version="2.2.0" />
    <PackageReference Include="Pure.RelationalSchema.HashCodes" Version="3.4.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
